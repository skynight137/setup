modules = ["python-base-3.13", "nodejs-24"]

[nix]
channel = "stable-25_05"
packages = ["rsync"]

[agent]
expertMode = true

[workflows]

[[workflows.workflow]]
name = "Update .agents"
mode = "sequential"
author = 43629746

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash .agents/scripts/updater.sh"


